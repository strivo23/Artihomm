# ArtiHome Backend Environment Configuration
# Set ENVIRONMENT=production for production deployments

# Django Environment
ENVIRONMENT=development
SECRET_KEY=django-insecure-artihome-dev-key-change-in-production-abc123xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database
DB_NAME=artihome
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=10

# CORS — Frontend dev server (local development)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Sheets Integration (Optional)
# Development: Place credentials.json in project root (automatically git-ignored)
# If using file: Leave GOOGLE_SHEETS_CREDENTIALS_JSON empty
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
